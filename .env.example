# Copy to .env and adjust for local development.
# docker-compose.yml reads this file automatically.

POSTGRES_USER=codearena
POSTGRES_PASSWORD=codearena
POSTGRES_DB=codearena
DATABASE_URL=postgresql://codearena:codearena@postgres:5432/codearena

REDIS_URL=redis://redis:6379

# Generate real secrets locally, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-please-32-chars-min
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-please-32-chars-min
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

API_PORT=4000
WEB_PORT=3000

# Per-user submission rate limit (Milestone 2).
SUBMISSION_RATE_LIMIT_MAX=30
SUBMISSION_RATE_LIMIT_WINDOW_MS=600000

# TTL for cached public problem metadata (Milestone 2).
PROBLEM_CACHE_TTL_SECONDS=60

# General per-IP request limit, applied to every request. The default is
# tuned for one browser's traffic; shared-IP/NAT'd or load-test traffic
# hits it fast at even modest concurrency — see load-tests/README.md.
GENERAL_RATE_LIMIT_MAX=300
GENERAL_RATE_LIMIT_WINDOW_MS=300000

# Judge worker concurrency.
WORKER_CONCURRENCY=2

# Used only by `npm run db:seed` to set the seeded users' password.
SEED_PASSWORD=ChangeMe123!
