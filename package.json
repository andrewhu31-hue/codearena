{
  "name": "codearena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:packages": "npm run build -w packages/config && npm run build -w packages/shared && npm run build -w packages/database",
    "build": "npm run build:packages && npm run build -w apps/api && npm run build -w apps/judge-worker && npm run build -w apps/web",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "npm run build:packages && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "dev:api": "npm run dev -w apps/api",
    "dev:worker": "npm run dev -w apps/judge-worker",
    "dev:web": "npm run dev -w apps/web",
    "db:generate": "npm run db:generate -w packages/database",
    "db:migrate": "npm run db:migrate -w packages/database",
    "db:seed": "npm run db:seed -w packages/database"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "prisma@5.22.0": true
  }
}
